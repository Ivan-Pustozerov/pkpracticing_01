				{
					"name": "Get Functions by Type(anal)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"var functions = pm.response.json();\r",
									"console.log(`📋 Found ${functions.length} function(s)`);\r",
									"\r",
									"// Если есть функции, выводим информацию\r",
									"if (functions.length > 0) {\r",
									"    functions.forEach((func, index) => {\r",
									"        console.log(`${index + 1}. ${func.name} (${func.type}) - ID: ${func.id}`);\r",
									"    });\r",
									"}\r",
									"// Дополнительные проверки для фильтрации по типу\r",
									"const url = pm.request.url.toString();\r",
									"if (url.includes('type=')) {\r",
									"    const expectedType = url.match(/type=(\\w+)/)[1];\r",
									"    pm.test(`All functions are of type '${expectedType}'`, function () {\r",
									"        functions.forEach(func => {\r",
									"            pm.expect(func.type).to.equal(expectedType);\r",
									"        });\r",
									"    });\r",
									"    console.log(`🔍 Filtered by type: ${expectedType}`);\r",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
